<?xml version="1.0" encoding="utf-8"?>
<!-- strip 탭 → 해당 2초 윈도우 확대 + CAM 토글. 설명 문구 없이 파형·버튼만. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="@dimen/pad_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/beatTimeText"
            style="@style/HiCardiOverline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="0:00" />

        <Button
            android:id="@+id/beatCamButton"
            style="@style/HiCardiButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="88dp"
            android:text="@string/cam_show" />
    </LinearLayout>

    <com.example.hicardimonitor.ui.widget.SaliencyWaveView
        android:id="@+id/beatWaveView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
