<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_screen"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/pad_screen"
        android:paddingBottom="40dp">

        <TextView
            style="@style/HiCardiTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monitor_title" />

        <TextView
            android:id="@+id/connectionBanner"
            style="@style/HiCardiCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sensor_disconnected"
            android:textColor="@color/text_error"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/realtime_plot_height"
            android:layout_marginTop="20dp">

            <com.example.hicardimonitor.EcgPlotView
                android:id="@+id/ecgView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/bpmOverlay"
                style="@style/HiCardiBpmOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:text="-- BPM" />
        </FrameLayout>

        <!-- AI 부정맥 진단 (6-class 실시간) -->
        <LinearLayout
            style="@style/HiCardiPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/HiCardiOverline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_diagnosis_overline" />

            <TextView
                android:id="@+id/aiPredClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_pred_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aiPredProb"
                style="@style/HiCardiCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ai_prob_placeholder" />

            <com.example.hicardimonitor.ui.widget.ArrhythmiaBarView
                android:id="@+id/aiBarView"
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/aiStatus"
                style="@style/HiCardiCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_status_waiting"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

        <!-- 그래프 설정 — 조용한 인라인 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HiCardiCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gain" />

                <EditText
                    android:id="@+id/gainEdit"
                    style="@style/HiCardiEdit"
                    android:layout_width="56dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginStart="8dp"
                    android:inputType="numberDecimal"
                    android:text="20" />

                <TextView
                    style="@style/HiCardiCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="mm/mV" />

                <TextView
                    style="@style/HiCardiCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Speed" />

                <EditText
                    android:id="@+id/speedEdit"
                    style="@style/HiCardiEdit"
                    android:layout_width="56dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginStart="8dp"
                    android:inputType="numberDecimal"
                    android:text="25" />

                <TextView
                    style="@style/HiCardiCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="mm/s" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/rPeakCheck"
                    style="@style/HiCardiCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R-Peak" />

                <CheckBox
                    android:id="@+id/bpmCheck"
                    style="@style/HiCardiCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:checked="true"
                    android:text="BPM" />

                <CheckBox
                    android:id="@+id/gridCheck"
                    style="@style/HiCardiCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:checked="true"
                    android:text="Grid" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
