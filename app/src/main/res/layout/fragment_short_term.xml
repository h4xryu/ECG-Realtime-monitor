<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shortTermList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/shortTermEmpty"
            style="@style/HiCardiCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:padding="@dimen/pad_screen"
            android:text="@string/short_term_empty"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_screen"
        android:paddingTop="13dp"
        android:paddingEnd="@dimen/pad_screen"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/startMeasureFab"
            style="@style/HiCardiButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:text="@string/start_short_term" />
    </LinearLayout>

</LinearLayout>
