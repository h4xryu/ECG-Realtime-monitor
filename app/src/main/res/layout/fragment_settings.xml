<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_screen"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/pad_screen"
        android:paddingBottom="@dimen/pad_screen">

        <TextView
            style="@style/HiCardiTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings" />

        <TextView
            style="@style/HiCardiOverline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="분석" />

        <LinearLayout
            style="@style/HiCardiPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/inferenceCheck"
                style="@style/HiCardiCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/enable_inference"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/personalizationCheck"
                style="@style/HiCardiCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="@string/apply_personalization"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/modelStatusText"
                style="@style/HiCardiCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="model: ..." />

            <TextView
                android:id="@+id/classifierStatusText"
                style="@style/HiCardiCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="classifier: ..." />
        </LinearLayout>

        <TextView
            style="@style/HiCardiOverline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/cloud_account_title" />

        <LinearLayout
            style="@style/HiCardiPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/accountStatusText"
                style="@style/HiCardiBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cloud_account_logged_out" />

            <EditText
                android:id="@+id/serverUrlEdit"
                style="@style/HiCardiEdit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_item"
                android:gravity="start|center_vertical"
                android:hint="@string/server_url_hint"
                android:inputType="textUri"
                android:maxLines="1" />

            <LinearLayout
                android:id="@+id/accountButtonsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_item"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/loginButton"
                    style="@style/HiCardiButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/cloud_account_login" />

                <Button
                    android:id="@+id/signupButton"
                    style="@style/HiCardiButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:text="@string/cloud_account_signup" />
            </LinearLayout>

            <Button
                android:id="@+id/logoutButton"
                style="@style/HiCardiButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_item"
                android:text="@string/cloud_account_logout"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
